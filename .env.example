# Copy to .env and edit:  cp .env.example .env
# ---- model ---------------------------------------------------------------
MODEL=Qwen/Qwen2.5-1.5B-Instruct
# only needed for gated models (e.g. Llama)
HF_TOKEN=
# host dir mounted into containers so weights download once
HF_CACHE_DIR=~/.cache/huggingface
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=64

# ---- vLLM (docker/compose.vllm.yml) --------------------------------------
VLLM_IMAGE=vllm/vllm-openai:v0.11.0
# per replica: 2 replicas share one 24 GB GPU at 0.40 each
GPU_MEM_UTIL=0.40
VLLM0_GPU=0
# set to 1 if you have a second GPU
VLLM1_GPU=0
VLLM2_GPU=0
VLLM3_GPU=0
# Cap each replica's KV pool so hot prefixes compete for cache space (8192 blocks x 16 = 131k tokens).
# Without a cap a big GPU caches everything and every routing policy looks the same.
VLLM_EXTRA_ARGS=--num-gpu-blocks-override 8192
# use configs/router/vllm_x4.yaml together with `--profile x4`
ROUTER_CONFIG=configs/router/vllm.yaml

# ---- SGLang (docker/compose.sglang.yml) ----------------------------------
# pin a specific tag for reproducibility
SGLANG_IMAGE=lmsysorg/sglang:latest
SGL0_GPU=0
SGL1_GPU=0
# SGLang fractions are of the WHOLE GPU; a 2nd replica on the same GPU needs a larger one
SGL0_MEM_FRACTION=0.40
SGL1_MEM_FRACTION=0.80
# try `lpm` (longest-prefix-match) for SGLang's intra-engine cache-aware scheduling
SGL_SCHEDULE_POLICY=fcfs
SGLANG_EXTRA_ARGS=--max-total-tokens 131072

# ---- disaggregated vLLM (docker/compose.vllm-disagg.yml) -----------------
PREFILL_GPU=0
DECODE_GPU=1
DISAGG_GPU_MEM_UTIL=0.85

# ---- simulator -------------------------------------------------------------
SIM_SPEED=1.0
